{
  "name": "upup-operacional",
  "version": "1.0.0",
  "description": "SaaS interno para gestão operacional da agência Up&Up",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:generate": "npm exec --workspace=apps/api -- prisma generate",
    "postinstall": "npm run db:generate",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=apps/api -- --runInBand",
    "test:e2e": "npm run test:e2e --workspace=apps/api -- --runInBand",
    "db:migrate": "npm exec --workspace=apps/api -- prisma migrate deploy",
    "db:seed": "npm exec --workspace=apps/api -- prisma db seed",
    "db:drift": "npm exec --workspace=apps/api -- prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "migration:check": "node scripts/check-migrations.mjs",
    "ci": "npm run migration:check && npm run lint && npm run typecheck && npm test && npm run build && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
