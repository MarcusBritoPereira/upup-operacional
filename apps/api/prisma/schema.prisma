datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(150)
  email           String        @unique @db.VarChar(150)
  passwordHash    String        @map("password_hash") @db.Text
  phone           String?       @db.VarChar(30)
  avatarUrl       String?       @map("avatar_url") @db.Text
  role            UserRole
  department      String?       @db.VarChar(80)
  position        String?       @db.VarChar(100)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  lastLoginAt        DateTime?     @map("last_login_at")
  lastLoginIp        String?       @map("last_login_ip") @db.VarChar(45)
  lastLoginUserAgent String?       @map("last_login_user_agent") @db.Text

  clientTeamRoles ClientTeamMember[]
  managedClients  Client[]      @relation("ClientManager")
  managedCycles   MonthlyCycle[]
  followups       WeeklyFollowup[]
  actionPlans     ActionPlan[]  @relation("ActionPlanResponsible")
  createdPlans    ActionPlan[]  @relation("ActionPlanCreator")
  timelineEvents  ClientTimeline[]
  resolvedAlerts  Alert[]       @relation("ResolvedAlerts")
  credentialAccessLogs CredentialAccessLog[]
  loginAuditLogs       LoginAuditLog[]
  activityAuditLogs    ActivityAuditLog[]
  userSessions         UserSession[]

  @@map("users")
}

model ClientTeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId, role])
  @@map("client_team_members")
}

model Client {
  id                  String                 @id @default(uuid()) @db.Uuid
  tradeName           String                 @map("trade_name") @db.VarChar(150)
  legalName           String?                @map("legal_name") @db.VarChar(180)
  segment             String?                @db.VarChar(100)
  status              ClientStatus           @default(active)
  entryDate           DateTime               @map("entry_date") @db.Date
  exitDate            DateTime?              @map("exit_date") @db.Date
  exitReason          String?                @map("exit_reason") @db.Text
  monthlyContractValue Decimal                @default(0) @map("monthly_contract_value") @db.Decimal(12, 2)
  managerId           String?                @map("manager_id") @db.Uuid
  decisionMakerName   String?                @map("decision_maker_name") @db.VarChar(150)
  decisionMakerPhone  String?                @map("decision_maker_phone") @db.VarChar(30)
  decisionMakerEmail  String?                @map("decision_maker_email") @db.VarChar(150)
  city                String?                @db.VarChar(100)
  state               String?                @db.VarChar(50)
  instagramUrl        String?                @map("instagram_url") @db.Text
  driveUrl            String?                @map("drive_url") @db.Text
  clickupUrl          String?                @map("clickup_url") @db.Text
  whatsappGroupUrl    String?                @map("whatsapp_group_url") @db.Text
  clientProfile       String?                @map("client_profile") @db.VarChar(80)
  marketingMaturity   String?                @map("marketing_maturity") @db.VarChar(40)
  strategicNotes      String?                @map("strategic_notes") @db.Text
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  manager             User?                  @relation("ClientManager", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers         ClientTeamMember[]
  contracts           Contract[]
  monthlyCycles       MonthlyCycle[]
  weeklyFollowups     WeeklyFollowup[]
  healthSnapshots     ClientHealthSnapshot[]
  actionPlans         ActionPlan[]
  alerts              Alert[]
  timelineEvents      ClientTimeline[]
  churnReasons        ChurnReason[]
  credentials         Credential[]
  serviceProviders    ClientServiceProvider[]

  @@index([status, managerId])
  @@map("clients")
}

model Contract {
  id           String         @id @default(uuid()) @db.Uuid
  clientId     String         @map("client_id") @db.Uuid
  startDate    DateTime       @map("start_date") @db.Date
  endDate      DateTime?      @map("end_date") @db.Date
  monthlyValue   Decimal        @map("monthly_value") @db.Decimal(12, 2)
  taxPercentage  Decimal?       @map("tax_percentage") @db.Decimal(5, 2)
  geePercentage  Decimal?       @map("gee_percentage") @db.Decimal(5, 2)
  geeFixedValue  Decimal?       @map("gee_fixed_value") @db.Decimal(12, 2)
  documentUrl    String?        @map("document_url") @db.Text
  status         ContractStatus @default(active)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deliverables   ContractDeliverable[]

  @@index([clientId, status])
  @@map("contracts")
}

model ServiceProvider {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  email     String?  @unique @db.VarChar(150)
  whatsapp  String?  @db.VarChar(30)
  role      String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clientLinks ClientServiceProvider[]

  @@map("service_providers")
}

model ClientServiceProvider {
  id                String   @id @default(uuid()) @db.Uuid
  clientId          String   @map("client_id") @db.Uuid
  serviceProviderId String   @map("service_provider_id") @db.Uuid
  role              String   @default("ServiceProvider") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")

  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@unique([clientId, serviceProviderId, role])
  @@index([clientId])
  @@index([serviceProviderId])
  @@map("client_service_providers")
}

model Credential {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  systemName  String   @map("system_name") @db.VarChar(100)
  url         String?  @db.Text
  username    String   @db.VarChar(150)
  password    String   @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accessLogs  CredentialAccessLog[]

  @@index([clientId])
  @@map("credentials")
}

model CredentialAccessLog {
  id           String   @id @default(uuid()) @db.Uuid
  credentialId String?  @map("credential_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at")

  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([credentialId, createdAt])
  @@index([userId, createdAt])
  @@map("credential_access_logs")
}

model DeliverableType {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String               @unique @db.VarChar(120)
  description        String?              @db.Text
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at")
  monthlyDeliverables MonthlyDeliverable[]
  contractDeliverables ContractDeliverable[]

  @@map("deliverable_types")
}

model ContractDeliverable {
  id                String          @id @default(uuid()) @db.Uuid
  contractId        String          @map("contract_id") @db.Uuid
  deliverableTypeId String          @map("deliverable_type_id") @db.Uuid
  quantity          Int             @default(0)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  contract          Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  deliverableType   DeliverableType @relation(fields: [deliverableTypeId], references: [id], onDelete: Restrict)

  @@unique([contractId, deliverableTypeId])
  @@index([contractId])
  @@map("contract_deliverables")
}

model MonthlyCycle {
  id           String                 @id @default(uuid()) @db.Uuid
  clientId     String                 @map("client_id") @db.Uuid
  month        Int
  year         Int
  managerId    String?                @map("manager_id") @db.Uuid
  status       CycleStatus            @default(open)
  healthScore  Int?                   @map("health_score")
  healthStatus HealthStatus           @default(gray) @map("health_status")
  closingNotes String?                @map("closing_notes") @db.Text
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  client              Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager             User?                  @relation(fields: [managerId], references: [id], onDelete: SetNull)
  monthlyDeliverables MonthlyDeliverable[]
  weeklyFollowups     WeeklyFollowup[]
  healthSnapshots     ClientHealthSnapshot[]
  actionPlans         ActionPlan[]

  @@unique([clientId, month, year])
  @@map("monthly_cycles")
}

model MonthlyDeliverable {
  id                String            @id @default(uuid()) @db.Uuid
  monthlyCycleId    String            @map("monthly_cycle_id") @db.Uuid
  deliverableTypeId String            @map("deliverable_type_id") @db.Uuid
  contractedQuantity Int               @default(0) @map("contracted_quantity")
  deliveredQuantity  Int               @default(0) @map("delivered_quantity")
  inProgressQuantity Int               @default(0) @map("in_progress_quantity")
  delayedQuantity    Int               @default(0) @map("delayed_quantity")
  status            DeliverableStatus @default(pending)
  notes             String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  monthlyCycle      MonthlyCycle      @relation(fields: [monthlyCycleId], references: [id], onDelete: Cascade)
  deliverableType   DeliverableType   @relation(fields: [deliverableTypeId], references: [id], onDelete: Restrict)

  @@unique([monthlyCycleId, deliverableTypeId])
  @@map("monthly_deliverables")
}

model WeeklyFollowup {
  id                         String       @id @default(uuid()) @db.Uuid
  clientId                   String       @map("client_id") @db.Uuid
  monthlyCycleId             String       @map("monthly_cycle_id") @db.Uuid
  managerId                  String       @map("manager_id") @db.Uuid
  weekStart                  DateTime     @map("week_start") @db.Date
  weekEnd                    DateTime     @map("week_end") @db.Date
  groupActivated             String?      @map("group_activated") @db.VarChar(30)
  clientResponded            String?      @map("client_responded") @db.VarChar(30)
  agencyRespondedOnTime      String?      @map("agency_responded_on_time") @db.VarChar(30)
  calendarOnTrack            String?      @map("calendar_on_track") @db.VarChar(30)
  hasDelayedDelivery         Boolean      @default(false) @map("has_delayed_delivery")
  clientShowedDissatisfaction Boolean      @default(false) @map("client_showed_dissatisfaction")
  delayedDeliveryReason      String?      @map("delayed_delivery_reason") @db.Text
  dissatisfactionReason      String?      @map("dissatisfaction_reason") @db.Text
  churnRisk                  String?      @map("churn_risk") @db.VarChar(30)
  weeklyScore                Int          @map("weekly_score")
  contentGeneratedQuantity   Int?         @map("content_generated_quantity")
  managerNotes               String?      @map("manager_notes") @db.Text
  recommendedAction          String?      @map("recommended_action") @db.Text
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  client                     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monthlyCycle               MonthlyCycle @relation(fields: [monthlyCycleId], references: [id], onDelete: Cascade)
  manager                    User         @relation(fields: [managerId], references: [id], onDelete: Restrict)

  @@unique([monthlyCycleId, weekStart])
  @@index([clientId, monthlyCycleId, weekStart])
  @@map("weekly_followups")
}

model ClientHealthSnapshot {
  id             String       @id @default(uuid()) @db.Uuid
  clientId       String       @map("client_id") @db.Uuid
  monthlyCycleId String       @map("monthly_cycle_id") @db.Uuid
  score          Int
  status         HealthStatus
  reason         String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monthlyCycle   MonthlyCycle @relation(fields: [monthlyCycleId], references: [id], onDelete: Cascade)

  @@map("client_health_snapshots")
}

model ActionPlan {
  id                String             @id @default(uuid()) @db.Uuid
  clientId          String             @map("client_id") @db.Uuid
  monthlyCycleId    String?            @map("monthly_cycle_id") @db.Uuid
  problem           String             @db.Text
  probableCause     String?            @map("probable_cause") @db.Text
  action            String             @db.Text
  responsibleId     String?            @map("responsible_id") @db.Uuid
  dueDate           DateTime?          @map("due_date") @db.Date
  priority          ActionPlanPriority @default(medium)
  status            ActionPlanStatus   @default(open)
  result            String?            @db.Text
  learning          String?            @db.Text
  canBecomePlaybook Boolean            @default(false) @map("can_become_playbook")
  createdById       String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monthlyCycle      MonthlyCycle?      @relation(fields: [monthlyCycleId], references: [id], onDelete: SetNull)
  responsible       User?              @relation("ActionPlanResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  creator           User?              @relation("ActionPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, responsibleId, status, dueDate])
  @@map("action_plans")
}

model Alert {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @map("client_id") @db.Uuid
  alertType   String        @map("alert_type") @db.VarChar(80)
  severity    AlertSeverity
  title       String        @db.VarChar(180)
  description String?       @db.Text
  status      AlertStatus   @default(open)
  createdAt   DateTime      @default(now()) @map("created_at")
  resolvedAt  DateTime?     @map("resolved_at")
  resolvedById String?       @map("resolved_by_id") @db.Uuid

  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  resolvedBy  User?         @relation("ResolvedAlerts", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([clientId, status, createdAt])
  @@map("alerts")
}

model ClientTimeline {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @map("client_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(80)
  title       String   @db.VarChar(180)
  description String?  @db.Text
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@map("client_timeline")
}

model ChurnReason {
  id                     String   @id @default(uuid()) @db.Uuid
  clientId               String   @map("client_id") @db.Uuid
  exitDate               DateTime @map("exit_date") @db.Date
  reasonCategory         String?  @map("reason_category") @db.VarChar(100)
  detailedReason         String?  @map("detailed_reason") @db.Text
  couldHaveBeenPrevented Boolean? @map("could_have_been_prevented")
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at")

  client                 Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("churn_reasons")
}


model LoginAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String   @db.VarChar(150)
  success       Boolean
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  failureReason String?  @map("failure_reason") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_audit_logs")
}

model ActivityAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(150)
  description String?  @db.Text
  method      String?  @db.VarChar(10)
  path        String?  @db.Text
  statusCode  Int?     @map("status_code")
  durationMs  Int?     @map("duration_ms")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("activity_audit_logs")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text
  loggedInAt   DateTime  @default(now()) @map("logged_in_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  loggedOutAt  DateTime? @map("logged_out_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason") @db.VarChar(150)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("user_sessions")
}


enum UserRole {
  super_admin
  admin
  diretoria
  gerencia
  gestor_cliente
  colaborador
}

enum ClientStatus {
  active
  inactive
  churned
}

enum ContractStatus {
  active
  inactive
  suspended
}

enum CycleStatus {
  open
  closed
}

enum HealthStatus {
  green
  yellow
  red
  gray
}

enum DeliverableStatus {
  pending
  delivered
  in_progress
  delayed
}

enum ActionPlanStatus {
  open
  in_progress
  completed
  cancelled
}

enum ActionPlanPriority {
  low
  medium
  high
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

enum AlertStatus {
  open
  resolved
}
