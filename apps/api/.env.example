# Environment variables — UP Gestão Operacional (API)
# Copie este arquivo para .env e preencha com seus valores.

DATABASE_URL="postgresql://upup_admin:upup_secure_password@localhost:5436/upup_operacional?schema=public"
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="1h"
PORT=3001
NODE_ENV="development"

# Origens exatas, separadas por vírgula. Em produção, use somente HTTPS.
CORS_ORIGINS="http://localhost:3000"

# Em produção, mantenha true para exigir Origin/Referer confiável em POST/PUT/PATCH/DELETE.
REQUIRE_TRUSTED_ORIGIN="false"

# Use "none" apenas quando frontend e API estiverem em sites diferentes.
# Nesse caso COOKIE_SECURE deve ser true e recomenda-se proteção CSRF adicional.
COOKIE_SAME_SITE="lax"
COOKIE_SECURE="false"
# COOKIE_DOMAIN=".upup.com"

# Chave para criptografar senhas de clientes em repouso.
# Em produção é obrigatória e deve ter pelo menos 32 caracteres.
CREDENTIALS_ENCRYPTION_KEY="gere-uma-chave-forte-com-pelo-menos-32-caracteres"

# Opcionais, usados somente pelo seed em development/test.
# SEED_ADMIN_PASSWORD="gere-uma-senha-local"
# SEED_MANAGER_PASSWORD="gere-uma-senha-local"

# ── Integração ClickUp ──
# Token pessoal do ClickUp (começa com pk_). Gere em:
# ClickUp → avatar (canto superior direito) → Settings → Apps → API Token.
CLICKUP_API_TOKEN=""
# Opcional. Se você tem mais de um workspace, fixe o ID do workspace alvo.
# Sem isso, a API usa o primeiro workspace que o token enxergar.
# CLICKUP_TEAM_ID=""
